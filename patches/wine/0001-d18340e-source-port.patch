+/* Private experimental bridge; the original native Unixlib path remains first. */
+static NTSTATUS (WINAPI *regression_elf_load)(const char *,UINT64 *,UINT64 *);
+static NTSTATUS (WINAPI *regression_elf_call)(UINT64,UINT,void *);
+static LONG (WINAPI *regression_elf_close)(UINT64);
+static NTSTATUS (WINAPI *regression_elf_attach_thread)(void);
+static NTSTATUS (WINAPI *regression_elf_prepare_thread)(void);
+static DWORD (WINAPI *regression_elf_thread_entry)(void*);
+struct regression_elf_module {UINT64 module,table;struct regression_elf_module *next;};
+static struct regression_elf_module *regression_elf_modules;
+static RTL_SRWLOCK regression_elf_lock;
+static BOOL regression_elf_owns(UINT64 value,BOOL module)
+{
+    struct regression_elf_module *p;
+    BOOL found=FALSE;
+    RtlAcquireSRWLockShared(&regression_elf_lock);
+    for(p=regression_elf_modules;p;p=p->next) if((module?p->module:p->table)==value){found=TRUE;break;}
+    RtlReleaseSRWLockShared(&regression_elf_lock);
+    return found;
+}
+static NTSTATUS regression_elf_unload(UINT64 module)
+{
+    struct regression_elf_module **p,*old=NULL;
+    if(regression_elf_close(module))return STATUS_INVALID_HANDLE;
+    RtlAcquireSRWLockExclusive(&regression_elf_lock);
+    for(p=&regression_elf_modules;*p;p=&(*p)->next)if((*p)->module==module){old=*p;*p=old->next;break;}
+    RtlReleaseSRWLockExclusive(&regression_elf_lock);
+    RtlFreeHeap(RtlGetCurrentPeb()->ProcessHeap,0,old);
+    return STATUS_SUCCESS;
+}
+
+static BOOL regression_load_elf_transport(void)
+{
+    static const WCHAR flag_name[] = L"REGRESSION_ELF_UNIXLIB";
+    WCHAR dll_name[1024];
+    UNICODE_STRING native_path;
+    UNICODE_STRING flag, value, name;
+    WCHAR enabled[4];
+    ANSI_STRING symbol;
+    HMODULE module;
+    if (regression_elf_load) return TRUE;
+    if(runtime_native_path(L"REGRESSION_ELF_TRANSPORT_DLL",dll_name,1024,&native_path))return FALSE;
+    RtlInitUnicodeString(&flag,flag_name);
+    value.Buffer=enabled;value.Length=0;value.MaximumLength=sizeof(enabled);
+    if (RtlQueryEnvironmentVariable_U(NULL,&flag,&value) || value.Length!=2 || enabled[0]!='1') return FALSE;
+    name=native_path;
+    if (LdrLoadDll(NULL,0,&name,&module)) return FALSE;
+#define RESOLVE(n) RtlInitAnsiString(&symbol,"fli_elf_" #n); \
+    if (LdrGetProcedureAddress(module,&symbol,0,(void **)&regression_elf_##n)) return FALSE
+    RESOLVE(call); RESOLVE(close); RESOLVE(attach_thread); RESOLVE(prepare_thread); RESOLVE(thread_entry); RESOLVE(load);
+#undef RESOLVE
+    return TRUE;
+}
+
+SYSCALL_API NTSTATUS WINAPI NtQueryVirtualMemory(HANDLE process,LPCVOID addr,MEMORY_INFORMATION_CLASS info_class,
+                                                PVOID buffer,SIZE_T len,SIZE_T *res_len)
+{
+    char root[4096];
+    WCHAR root_path[1024];
+    UNICODE_STRING root_name, root_value;
+    ULONG root_bytes;
+    NTSTATUS status;
+    const UNICODE_STRING *name=addr;
+    UINT64 handles[2];
+    struct regression_elf_module *loaded;
+    LDR_DATA_TABLE_ENTRY *entry;
+    UNICODE_STRING image_name;
+    WCHAR image_path[1024];
+    ULONG bytes=0,i;
+    char *path,*guest;
+    char native_path[4096];
+    if (process==NtCurrentProcess() && info_class==MemoryWineUnloadUnixLib && addr &&
+        regression_elf_owns(*(const UINT64 *)addr,TRUE))
+        return regression_elf_unload(*(const UINT64 *)addr);
+    status=syscall_NtQueryVirtualMemory(process,addr,info_class,buffer,len,res_len);
+    if (status!=STATUS_DLL_NOT_FOUND || process!=NtCurrentProcess() || (info_class!=MemoryWineLoadUnixLibByName && info_class!=MemoryWineLoadUnixLib)) return status;
+    RtlInitUnicodeString(&root_name,L"VRCHAT_ROOTFS");
+    root_value.Buffer=root_path;root_value.Length=0;root_value.MaximumLength=sizeof(root_path);
+    if (RtlQueryEnvironmentVariable_U(NULL,&root_name,&root_value) ||
+        RtlUnicodeToUTF8N(root,sizeof(root)-1,&root_bytes,root_value.Buffer,root_value.Length)) return status;
+    root[root_bytes]=0;
+    if (info_class==MemoryWineLoadUnixLib)
+    {
+        if (!syscall_NtQueryVirtualMemory(process,addr,(MEMORY_INFORMATION_CLASS)0x7fff0001,
+                                         native_path,sizeof(native_path),NULL))
+        {
+            bytes=strlen(native_path);
+            if (!(path=RtlAllocateHeap(RtlGetCurrentPeb()->ProcessHeap,0,bytes+1))) return STATUS_NO_MEMORY;
+            memcpy(path,native_path,bytes+1);
+            goto path_ready;
+        }
+        if (LdrFindEntryForAddress(addr,&entry) || entry->FullDllName.Length<8 ||
+            entry->FullDllName.Length>=sizeof(image_path)) return status;
+        memcpy(image_path,entry->FullDllName.Buffer,entry->FullDllName.Length);
+        i=entry->FullDllName.Length/sizeof(WCHAR);
+        if (image_path[i-4]!='.') return status;
+        image_path[i-3]='s';image_path[i-2]='o';image_path[i-1]=0;
+        image_name.Buffer=image_path;image_name.Length=(i-1)*sizeof(WCHAR);image_name.MaximumLength=sizeof(image_path);
+        name=&image_name;
+    }
+    if (!name || !name->Buffer || !buffer) return STATUS_INVALID_PARAMETER;
+    if (RtlUnicodeToUTF8N(NULL,0,&bytes,name->Buffer,name->Length)) return status;
+    if (!(path=RtlAllocateHeap(RtlGetCurrentPeb()->ProcessHeap,0,bytes+1))) return STATUS_NO_MEMORY;
+    if (RtlUnicodeToUTF8N(path,bytes,&bytes,name->Buffer,name->Length)) {RtlFreeHeap(RtlGetCurrentPeb()->ProcessHeap,0,path);return status;}
+    path[bytes]=0;
+path_ready:
+    for(i=0;i<bytes;i++)if(path[i]=='\\')path[i]='/';
+    guest=path;
+    if (!strncmp(guest,"/??/Z:/",7)) guest+=6;
+    else if (!strncmp(guest,"Z:/",3) || !strncmp(guest,"z:/",3)) guest+=2;
+    if (!strncmp(guest,root,root_bytes) && guest[root_bytes]=='/') guest+=root_bytes;
+    /* Only explicit paths in the actual isolated ELF namespace are considered. */
+    if (!strncmp(guest,"/opt/",5) && regression_load_elf_transport())
+    {
+        status=regression_elf_load(guest,&handles[0],&handles[1]);
+        if (!status)
+        {
+            if (!(loaded=RtlAllocateHeap(RtlGetCurrentPeb()->ProcessHeap,0,sizeof(*loaded))))
+            { regression_elf_close(handles[0]);status=STATUS_NO_MEMORY; }
+            else
+            {
+                loaded->module=handles[0];loaded->table=handles[1];
+                RtlAcquireSRWLockExclusive(&regression_elf_lock);
+                loaded->next=regression_elf_modules;regression_elf_modules=loaded;
+                RtlReleaseSRWLockExclusive(&regression_elf_lock);
+                memcpy(buffer,info_class==MemoryWineLoadUnixLib ? handles+1 : handles,
+                       min(len,info_class==MemoryWineLoadUnixLib ? sizeof(handles[1]) : sizeof(handles)));
+            }
+        }
+    }
+    RtlFreeHeap(RtlGetCurrentPeb()->ProcessHeap,0,path);
+    return status;
+}
+
+NTSTATUS __wine_unix_call_arm64ec(unixlib_handle_t handle,unsigned int code,void *args)
+{
+    if (handle!=regression_linux_handle && regression_elf_owns(handle,FALSE)) return regression_elf_call(handle,code,args);
+    return regression_native_unix_call(handle,code,args);
+}
