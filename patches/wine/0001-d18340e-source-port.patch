+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Native Unix library paths are supplied by the launcher, in UTF-16. */
+static NTSTATUS runtime_native_path(const WCHAR *variable, WCHAR *buffer,
+                                    USHORT capacity, UNICODE_STRING *path)
+{
+    UNICODE_STRING name, value;
+    NTSTATUS status;
+    unsigned int i;
+    RtlInitUnicodeString(&name,variable);
+    value.Buffer=buffer+6;value.Length=0;
+    value.MaximumLength=(capacity-7)*sizeof(WCHAR);
+    if ((status=RtlQueryEnvironmentVariable_U(NULL,&name,&value))) return status;
+    if (!value.Length || value.Buffer[0]!='/') return STATUS_INVALID_PARAMETER;
+    memcpy(buffer,L"\\??\\Z:",6*sizeof(WCHAR));
+    for (i=0;i<value.Length/sizeof(WCHAR);++i)
+        if(value.Buffer[i]=='/')value.Buffer[i]='\\';
+    path->Buffer=buffer;path->Length=value.Length+6*sizeof(WCHAR);
+    path->MaximumLength=capacity*sizeof(WCHAR);
+    buffer[path->Length/sizeof(WCHAR)]=0;
+    return STATUS_SUCCESS;
+}
