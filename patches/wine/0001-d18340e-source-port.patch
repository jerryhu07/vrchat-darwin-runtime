+/* Deliver confirmed external ELF mappings from the Windows user stack. */
+NTSTATUS WINAPI __wine_register_elf_regions(const void *opaque)
+{
+    struct execution_regions {
+        ULONG size,count;
+        struct {ULONG64 address,length;ULONG protect,reserved;} regions[16];
+    };
+    const struct execution_regions *ranges=opaque;
+    ULONG i;
+    if(!ranges || ranges->size!=sizeof(*ranges) || !ranges->count || ranges->count>16)
+        return STATUS_INVALID_PARAMETER;
+    if(!pNotifyMemoryAlloc)return STATUS_NOT_SUPPORTED;
+    for(i=0;i<ranges->count;i++)
+        if(!ranges->regions[i].length || ranges->regions[i].address+ranges->regions[i].length<ranges->regions[i].address ||
+           (ranges->regions[i].protect!=PAGE_EXECUTE_READ && ranges->regions[i].protect!=PAGE_EXECUTE_READWRITE))
+            return STATUS_INVALID_PARAMETER;
+    if(!enter_syscall_callback())return STATUS_INVALID_DEVICE_STATE;
+    for(i=0;i<ranges->count;i++) {
+        void *address=(void*)ranges->regions[i].address;
+        SIZE_T length=ranges->regions[i].length;
+        ULONG protect=ranges->regions[i].protect;
+        pNotifyMemoryAlloc(address,length,MEM_COMMIT,protect,FALSE,0);
+        pNotifyMemoryAlloc(address,length,MEM_COMMIT,protect,TRUE,0);
+    }
+    leave_syscall_callback();
+    return STATUS_SUCCESS;
+}
+
+/* Only a thread entering the real raw Linux ABI takes this lazy initializer. */
+static void DECLSPEC_NORETURN regression_attach_linux_on_user_stack( ARM64_NT_CONTEXT *saved )
+{
+    ARM64EC_NT_CONTEXT context;
+    NTSTATUS status;
+    context_arm_to_x64( &context, saved );
+    RtlFreeHeap( RtlGetCurrentPeb()->ProcessHeap, 0, saved );
+    status = regression_load_elf_transport() ? regression_elf_attach_thread() : STATUS_DLL_NOT_FOUND;
+    __wine_unix_call_arm64ec( regression_linux_handle, 6, &status );
+    if (!status) context.Pc -= 2; /* Retry the pending x86-64 syscall instruction. */
+    else context.X8 = status == STATUS_NO_MEMORY ? (ULONG64)-12 : (ULONG64)-5;
+    NtContinue( &context.AMD64_Context, FALSE );
+    RtlRaiseStatus( STATUS_INVALID_DEVICE_STATE );
+}
+
+static void regression_schedule_linux_thread_attach( ARM64_NT_CONTEXT *context )
+{
+    ARM64_NT_CONTEXT *saved = RtlAllocateHeap( RtlGetCurrentPeb()->ProcessHeap, 0, sizeof(*saved) );
+    if (!saved)
+    {
+        NTSTATUS status = STATUS_NO_MEMORY;
+        __wine_unix_call_arm64ec( regression_linux_handle, 6, &status );
+        context->X8 = (ULONG64)-12;
+        return;
+    }
+    *saved = *context;
+    context->X0 = (ULONG_PTR)saved;
+    context->Sp = (context->Sp & ~(ULONG64)15) - 32;
+    context->Pc = (ULONG_PTR)regression_attach_linux_on_user_stack;
+}
