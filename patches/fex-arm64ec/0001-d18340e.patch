 FEXCore::CodeMapFileId ComputeCodeMapId(std::string_view FileName, uint32_t TimeDateStamp, uint32_t SizeOfImage) {
   const auto Norm {ToLower(FileName)};
+  // Prefer complete on-disk PE content. Timestamp/size alone permits stale or
+  // locally patched binaries to reuse translated code from another image.
+  // Stay on ntdll here: WoW64 image notifications run on a small native
+  // transition stack, and CRT/kernel32 file I/O can recurse into the loader.
+  const auto NtFileName = FileName.starts_with("\\??\\") ? fextl::string {FileName} : fextl::fmt::format("\\??\\{}", FileName);
+  ScopedUnicodeString NtPath(NtFileName.c_str());
+  OBJECT_ATTRIBUTES FileAttributes;
+  InitializeObjectAttributes(&FileAttributes, &*NtPath, OBJ_CASE_INSENSITIVE, nullptr, nullptr);
+  IO_STATUS_BLOCK IOSB;
+  ScopedHandle FileHandle;
+  if (NT_SUCCESS(NtOpenFile(&*FileHandle, FILE_READ_DATA | SYNCHRONIZE, &FileAttributes, &IOSB,
+                            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_SYNCHRONOUS_IO_NONALERT))) {
+    ScopedHandle SectionHandle;
+    if (NT_SUCCESS(NtCreateSection(&*SectionHandle, SECTION_MAP_READ, nullptr, nullptr, PAGE_READONLY, SEC_COMMIT, *FileHandle))) {
+      void* View = nullptr;
+      SIZE_T ViewSize = 0;
+      if (NT_SUCCESS(NtMapViewOfSection(*SectionHandle, NtCurrentProcess(), &View, 0, 0, nullptr, &ViewSize, ViewUnmap,
+                                        MEM_RESERVE | MEM_TOP_DOWN, PAGE_READONLY))) {
+        const uint64_t Hash = XXH3_64bits(View, ViewSize);
+        NtUnmapViewOfSection(NtCurrentProcess(), View);
+        return Hash;
+      }
+    }
+  }
+
+  // Preserve a deterministic fallback for synthetic/non-file-backed images.
   return XXH3_64bits(Norm.data(), Norm.size()) ^ (static_cast<uint64_t>(SizeOfImage) << 32 | TimeDateStamp);
 }
 
