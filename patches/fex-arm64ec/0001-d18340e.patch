+ARMEmitter::Register Arm64JITCore::TranslateGuestAddress(ARMEmitter::Register Guest) {
+#ifdef ARCHITECTURE_arm64ec
+  /*
+   * x64 guests use the architectural KUSER_SHARED_DATA page at 0x7ffe0000.
+   * Darwin cannot map below 4 GiB, so Wine owns that page at 0x17ffe0000.
+   * Keep every guest register architectural and translate only the effective
+  * address used by the generated host memory instruction.
+   */
+  // Keep architectural addresses on the hot path. The existing native
+  // continuation retries KUSER faults through Wine's high shared-data page.
+  mov(ARMEmitter::Size::i64Bit, TMP4, Guest.X());
+  return TMP4;
+#else
+  // The normal ARM64EC/x64 provider retains FEX's native host-pointer
+  // contract.  The WoW64 provider is the sole 32-bit guest-page-table user.
+  if (CTX->Config.Is64BitMode) return Guest;
+
+  and_(ARMEmitter::Size::i64Bit, TMP1, Guest, UINT64_C(0xffffffff));
+  and_(ARMEmitter::Size::i64Bit, TMP2, TMP1, UINT64_C(~0xfff));
+  lsr(ARMEmitter::Size::i64Bit, TMP2, TMP2, 9);
+  add(ARMEmitter::Size::i64Bit, TMP2, REG_GUEST_PAGE_TABLE, TMP2);
+  ldr(REG_MEMORY_ADDRESS, TMP2, 0);
+  and_(ARMEmitter::Size::i64Bit, TMP1, TMP1, 0xfff);
+  add(ARMEmitter::Size::i64Bit, REG_MEMORY_ADDRESS, REG_MEMORY_ADDRESS, TMP1);
+  return REG_MEMORY_ADDRESS;
+#endif
 }
 
