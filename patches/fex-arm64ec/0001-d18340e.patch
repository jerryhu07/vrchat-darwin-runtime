+static bool IsSharedRuntimeCacheCandidate(std::string_view ModuleName) {
+  const auto Name = ToLower(ModuleName);
+  const char* Configured = getenv("FEX_WINDOWS_RUNTIME_CACHE_DLLS");
+  // UCRT and MSVCRT contain process-initialized dispatch paths and are not
+  // cross-process cache candidates until their mutation contract is encoded
+  // in cache identity/invalidation.  Graphics qualification currently covers
+  // only these fixed Wine runtime images.
+  const std::string_view List = Configured ? std::string_view {Configured} : "ntdll.dll,kernelbase.dll,kernel32.dll";
+  for (size_t Begin = 0; Begin <= List.size();) {
+    const size_t End = List.find(',', Begin);
+    auto Candidate = List.substr(Begin, End == std::string_view::npos ? List.size() - Begin : End - Begin);
+    while (!Candidate.empty() && std::isspace(static_cast<unsigned char>(Candidate.front()))) Candidate.remove_prefix(1);
+    while (!Candidate.empty() && std::isspace(static_cast<unsigned char>(Candidate.back()))) Candidate.remove_suffix(1);
+    if (ToLower(Candidate) == Name) {
+      return true;
+    }
+    if (End == std::string_view::npos) break;
+    Begin = End + 1;
+  }
+  return false;
+}
