--- /dev/null
+++ b/Source/Windows/Common/CacheStack.S
@@ -0,0 +1,25 @@
+.text
+.balign 16
+
+// void RunOnCacheStack(void* StackTop, ImageTracker* Tracker,
+//                      InternalThreadState* Thread)
+//
+// Wine's process-termination callbacks may arrive with only one 16-KiB native
+// transition-stack page committed. Cache serialization uses filesystem and
+// container code that legitimately needs more room, so run it on a bounded,
+// private stack without creating another Windows/FEX thread.
+.global RunOnCacheStack
+RunOnCacheStack:
+  mov x9, sp
+  mov sp, x0
+  stp x9, x30, [sp, #-16]!
+  mov x0, x1
+  mov x1, x2
+#ifdef ARCHITECTURE_arm64ec
+  bl "#FEXWindowsSaveRuntimeCache"
+#else
+  bl FEXWindowsSaveRuntimeCache
+#endif
+  ldp x9, x30, [sp], #16
+  mov sp, x9
+  ret
