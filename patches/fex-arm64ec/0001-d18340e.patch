+void ImageTracker::LoadAndEnableCache(MappedImageInfo& Info, FEXCore::Core::InternalThreadState* Thread) {
+  const auto ID = FEXCore::CodeMap::GetBaseFilename(Info.Info, false);
+  auto AOTImage = AOTImages.lower_bound(ID);
+  while (AOTImage != AOTImages.end() && AOTImage->first.starts_with(ID)) {
+    const auto Suffix = std::string_view {AOTImage->first}.substr(ID.size());
+    if (Suffix.empty() || Suffix.starts_with("-")) {
+      break;
+    }
+    ++AOTImage;
+  }
+  if (AOTImage == AOTImages.end()) {
+    return;
+  }
+  if (!AOTImage->first.starts_with(ID) ||
+      (!std::string_view {AOTImage->first}.substr(ID.size()).empty() &&
+       !std::string_view {AOTImage->first}.substr(ID.size()).starts_with("-"))) {
+    return;
+  }
+
+  auto& CodeCache = CTX.GetCodeCache();
+  if (!Info.MappedCache) {
+    for (; AOTImage != AOTImages.end() && AOTImage->first.starts_with(ID); ++AOTImage) {
+      const auto Suffix = std::string_view {AOTImage->first}.substr(ID.size());
+      if (!Suffix.empty() && !Suffix.starts_with("-")) {
+        continue;
+      }
+      Info.MappedCache = CodeCache.LoadCache(std::span {AOTImage->second.Data, AOTImage->second.Size}, Info.Info,
+                                             Info.SectionInfo.FileStartVA);
+      if (Info.MappedCache) {
+        FEX::Windows::Logging::PerfEvent("cache_loaded", AOTImage->first.c_str());
+        break;
+      }
+    }
+    if (!Info.MappedCache) {
+      return;
+    }
+    CodeCache.RegisterMappedCodeBuffer(*Info.MappedCache);
+  }
+
+  if (Thread && !Info.CacheEnabled) {
+    if (CodeCache.EnableLoadedSection(Thread, *Info.MappedCache, Info.SectionInfo)) {
+      Info.CacheEnabled = true;
+      // A validated cache already exists for this process/configuration.
+      // Do not rewrite it during ProcessTerm; live-JIT misses remain a safe
+      // process-local fallback and can be incorporated by an explicit rebuild.
+      const auto Detail = fmt::format("id={} blocks={}", ID, Info.MappedCache->NumBlocks);
+      FEX::Windows::Logging::PerfEvent("cache_enabled", Detail.c_str());
+      LogMan::Msg::IFmt("Enabled cache: {}", ID);
+    } else {
+      // Optional cache failure must remain a safe live-JIT fallback.
+      Info.MappedCache.reset();
+    }
+  }
+}
+
+void ImageTracker::EnablePendingSections(FEXCore::Core::InternalThreadState* Thread) {
+  if (!Thread || !FEXCore::Config::Get_ENABLECODECACHINGWIP() || IsGeneratingCache) {
+    return;
+  }
+
+  std::scoped_lock Lock(CTX.GetCodeInvalidationMutex());
+  std::unique_lock ImagesGuard {ImagesLock};
+  for (auto& [_, Info] : MappedImages) {
+    LoadAndEnableCache(Info, Thread);
+  }
+}
+
+void ImageTracker::FlushCodeMap(FEXCore::Core::InternalThreadState* Thread, bool SaveRuntimeCache) {
+  // Windows providers are not guaranteed to run C++ global destructors during
+  // process teardown. Releasing the writer here commits its final partial
+  // buffer and closes the code-map file deterministically.
+  CTX.SetCodeMapWriter(nullptr);
+
+  if (SaveRuntimeCache) {
+    const auto Detail = fmt::format("complete={} enabled={} main={:x} images={}", RuntimeCacheSaveComplete,
+                                    static_cast<bool>(FEXCore::Config::Get_ENABLECODECACHINGWIP()), MainImageAddress,
+                                    MappedImages.size());
+    FEX::Windows::Logging::PerfEvent("cache_save_attempt", Detail.c_str());
+  }
+  if (!SaveRuntimeCache || RuntimeCacheSaveComplete || !FEXCore::Config::Get_ENABLECODECACHINGWIP() || !MainImageAddress) {
+    return;
+  }
+
+  static constexpr size_t CacheStackSize = 512 * 1024;
+  void* CacheStack = ::VirtualAlloc(nullptr, CacheStackSize, MEM_COMMIT | MEM_RESERVE | MEM_TOP_DOWN, PAGE_READWRITE);
+  if (!CacheStack) {
+    LogMan::Msg::EFmt("Failed to allocate runtime code-cache worker stack");
+    return;
+  }
+  RunOnCacheStack(static_cast<std::byte*>(CacheStack) + CacheStackSize, this, Thread);
+  ::VirtualFree(CacheStack, 0, MEM_RELEASE);
+}
+
+void ImageTracker::SaveRuntimeCache(FEXCore::Core::InternalThreadState* Thread) {
+  std::scoped_lock Lock(CTX.GetCodeInvalidationMutex());
+  std::shared_lock ImagesGuard {ImagesLock};
+  auto& CodeCache = CTX.GetCodeCache();
+  const auto CacheRoot = fmt::format("{}cache", FEX::Config::GetCacheDirectory());
+  const auto EnsureDirectory = [](const char* Path) {
+    return CreateDirectoryA(Path, nullptr) || GetLastError() == ERROR_ALREADY_EXISTS;
+  };
+  if (!EnsureDirectory(FEX::Config::GetCacheDirectory().c_str()) || !EnsureDirectory(CacheRoot.c_str())) {
+    LogMan::Msg::EFmt("Failed to create runtime code-cache root: {}", GetLastError());
+    return;
+  }
+
+  for (auto& [_, Image] : MappedImages) {
+    if (!Image.RuntimeCacheEligible || Image.CacheEnabled) {
+      continue;
+    }
+
+    const auto ID = FEXCore::CodeMap::GetBaseFilename(Image.Info, false);
+    const auto CacheDirectory = fmt::format("{}cache\\{}\\", FEX::Config::GetCacheDirectory(), ID);
+    if (!EnsureDirectory(CacheDirectory.c_str())) {
+      LogMan::Msg::EFmt("Failed to create runtime code-cache directory for {}: {}", ID, GetLastError());
+      continue;
+    }
+    FEX::Windows::Logging::PerfEvent("cache_directory_ready", ID.c_str());
+
+    const auto CachePath = fmt::format("{}{}-{:016x}", CacheDirectory, ID, CodeCache.GetConfigId());
+    const auto TemporaryPath = CachePath + ".new";
+    const int FD = _sopen(TemporaryPath.c_str(), O_CREAT | O_TRUNC | O_WRONLY | O_BINARY, _SH_DENYRW, 0644);
+    if (FD == -1) {
+      FEX::Windows::Logging::PerfEvent("cache_open_failed", ID.c_str());
+      continue;
+    }
+
+    const bool Saved = CodeCache.SaveData(FD, Image.SectionInfo, Image.SectionInfo.FileStartVA);
+    FEX::Windows::Logging::PerfEvent(Saved ? "cache_serialized" : "cache_serialize_failed", ID.c_str());
+    _close(FD);
+    if (!Saved) {
+      DeleteFileA(TemporaryPath.c_str());
+      continue;
+    }
+
+    if (!MoveFileExA(TemporaryPath.c_str(), CachePath.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+      const bool RemovedInvalidTarget = DeleteFileA(CachePath.c_str());
+      if (!RemovedInvalidTarget || !MoveFileExA(TemporaryPath.c_str(), CachePath.c_str(), MOVEFILE_WRITE_THROUGH)) {
+        const auto RepairPath = CachePath + ".repaired";
+        DeleteFileA(RepairPath.c_str());
+        if (!MoveFileExA(TemporaryPath.c_str(), RepairPath.c_str(), MOVEFILE_WRITE_THROUGH)) {
+          LogMan::Msg::EFmt("Failed to publish runtime code cache for {}: {}", ID, GetLastError());
+          DeleteFileA(TemporaryPath.c_str());
+          continue;
+        }
+      }
+    }
+    FEX::Windows::Logging::PerfEvent("cache_saved", ID.c_str());
+    LogMan::Msg::IFmt("Saved runtime cache: {}", CachePath);
+  }
+  RuntimeCacheSaveComplete = true;
+}
