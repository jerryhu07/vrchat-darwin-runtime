+void FEXCore::Context::ContextImpl::SetGuestMemoryAddressBias(
+  uint64_t Bias, uint64_t Limit, uint64_t RedirectGuestPage, uint64_t RedirectHostPage) {
+  Config.GuestMemoryAddressBias = Bias;
+  Config.GuestMemoryAddressLimit = Limit;
+  Config.GuestMemoryRedirectGuestPage = RedirectGuestPage;
+  Config.GuestMemoryRedirectHostPage = RedirectHostPage;
+}
+
+bool FEXCore::Context::ContextImpl::SetGuestMemoryAddressRegions(
+  const GuestMemoryAddressRegion* Regions, size_t Count) {
+  if (Count > GUEST_MEMORY_ADDRESS_REGION_CAPACITY || (Count != 0 && Regions == nullptr)) {
+    return false;
+  }
+
+  std::array<GuestMemoryAddressRegion, GUEST_MEMORY_ADDRESS_REGION_CAPACITY> Validated {};
+  for (size_t Index = 0; Index < Count; ++Index) {
+    const auto& Region = Regions[Index];
+    const bool IsAligned =
+      (Region.GuestBase & 0xFFF) == 0
+      && (Region.HostBase & 0xFFF) == 0
+      && (Region.Size & 0xFFF) == 0;
+    const bool HasValidBounds =
+      Region.HostBase != 0
+      && Region.Size != 0
+      && Region.GuestBase <= UINT64_MAX - Region.Size
+      && Region.HostBase <= UINT64_MAX - Region.Size;
+    if (!IsAligned || !HasValidBounds) {
+      return false;
+    }
+
+    if (Config.GuestMemoryAddressBias != 0
+        && Config.GuestMemoryAddressLimit != 0
+        && Region.GuestBase < Config.GuestMemoryAddressLimit) {
+      return false;
+    }
+
+    const auto RangesOverlap = [](uint64_t BaseA, uint64_t SizeA,
+                                  uint64_t BaseB, uint64_t SizeB) {
+      return BaseA < BaseB + SizeB && BaseB < BaseA + SizeA;
+    };
+    if (Config.GuestMemoryAddressBias != 0
+        && Config.GuestMemoryAddressLimit != 0
+        && Config.GuestMemoryAddressBias
+             <= UINT64_MAX - Config.GuestMemoryAddressLimit
+        && RangesOverlap(
+          Region.HostBase,
+          Region.Size,
+          Config.GuestMemoryAddressBias,
+          Config.GuestMemoryAddressLimit)) {
+      return false;
+    }
+    if (Config.GuestMemoryRedirectHostPage != 0
+        && Config.GuestMemoryRedirectHostPage <= UINT64_MAX - 0x1000
+        && RangesOverlap(
+          Region.HostBase,
+          Region.Size,
+          Config.GuestMemoryRedirectHostPage,
+          0x1000)) {
+      return false;
+    }
+
+    const uint64_t RegionEnd = Region.GuestBase + Region.Size;
+    for (size_t Previous = 0; Previous < Index; ++Previous) {
+      const auto& Other = Validated[Previous];
+      const uint64_t OtherEnd = Other.GuestBase + Other.Size;
+      if ((Region.GuestBase < OtherEnd && Other.GuestBase < RegionEnd)
+          || RangesOverlap(
+            Region.HostBase,
+            Region.Size,
+            Other.HostBase,
+            Other.Size)) {
+        return false;
+      }
+    }
+    Validated[Index] = Region;
+  }
+
+  Config.GuestMemoryAddressRegions = Validated;
+  return true;
+}
+
+bool FEXCore::Context::ContextImpl::TranslateGuestMemoryAddress(
+  uint64_t GuestAddress, uint64_t* HostAddress) const {
+  if (HostAddress == nullptr) {
+    return false;
+  }
+
+  if (Config.GuestMemoryAddressBias != 0
+      && Config.GuestMemoryAddressLimit != 0
+      && GuestAddress < Config.GuestMemoryAddressLimit) {
+    if (Config.GuestMemoryRedirectGuestPage != 0
+        && Config.GuestMemoryRedirectHostPage != 0
+        && GuestAddress >= Config.GuestMemoryRedirectGuestPage
+        && GuestAddress - Config.GuestMemoryRedirectGuestPage < 0x1000) {
+      *HostAddress = Config.GuestMemoryRedirectHostPage
+        + (GuestAddress - Config.GuestMemoryRedirectGuestPage);
+      return true;
+    }
+    if (GuestAddress <= UINT64_MAX - Config.GuestMemoryAddressBias) {
+      *HostAddress = Config.GuestMemoryAddressBias + GuestAddress;
+      return true;
+    }
+    return false;
+  }
+
+  for (const auto& Region : Config.GuestMemoryAddressRegions) {
+    if (Region.Size != 0
+        && GuestAddress >= Region.GuestBase
+        && GuestAddress - Region.GuestBase < Region.Size) {
+      *HostAddress = Region.HostBase + (GuestAddress - Region.GuestBase);
+      return true;
+    }
+  }
+  return false;
+}
+
+bool FEXCore::Context::ContextImpl::TranslateHostMemoryAddress(
+  uint64_t HostAddress, uint64_t* GuestAddress) const {
+  if (GuestAddress == nullptr) {
+    return false;
+  }
+
+  if (Config.GuestMemoryRedirectGuestPage != 0
+      && Config.GuestMemoryRedirectHostPage != 0
+      && HostAddress >= Config.GuestMemoryRedirectHostPage
+      && HostAddress - Config.GuestMemoryRedirectHostPage < 0x1000) {
+    *GuestAddress = Config.GuestMemoryRedirectGuestPage
+      + (HostAddress - Config.GuestMemoryRedirectHostPage);
+    return true;
+  }
+
+  for (const auto& Region : Config.GuestMemoryAddressRegions) {
+    if (Region.Size != 0
+        && HostAddress >= Region.HostBase
+        && HostAddress - Region.HostBase < Region.Size) {
+      *GuestAddress = Region.GuestBase + (HostAddress - Region.HostBase);
+      return true;
+    }
+  }
+
+  if (Config.GuestMemoryAddressBias != 0
+      && Config.GuestMemoryAddressLimit != 0
+      && HostAddress >= Config.GuestMemoryAddressBias
+      && HostAddress - Config.GuestMemoryAddressBias
+        < Config.GuestMemoryAddressLimit) {
+    *GuestAddress = HostAddress - Config.GuestMemoryAddressBias;
+    return true;
+  }
+  return false;
+}
+
 FEXCore::CPUID::FunctionResults FEXCore::Context::ContextImpl::RunCPUIDFunction(uint32_t Function, uint32_t Leaf) {
   return CPUID.RunFunction(Function, Leaf);
 }
