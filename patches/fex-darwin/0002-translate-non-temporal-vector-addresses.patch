+ARMEmitter::Register Arm64JITCore::ApplyGuestMemoryAddressBias(ARMEmitter::Register Base, int32_t& Offset) {
+  if (!IsGuestMemoryAddressTranslationEnabled()) {
+    return Base;
+  }
+
+  // Translate the effective guest address, which may be in a different region than Base.
+  if (Offset != 0) {
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Offset);
+    add(ARMEmitter::Size::i64Bit, TMP1, Base, TMP1);
+    Base = TMP1;
+    Offset = 0;
+  }
+  return ApplyGuestMemoryAddressBias(Base);
 }
 
